# Copy to .env.local; all values below are placeholders, never real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERVER ONLY — never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/drive/callback
# 32 random bytes as 64 hex characters; generate locally, never commit.
TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
# Keep off until the provider + worker + scheduler are implemented and tested.
ENABLE_EMAIL_DISPATCH=false
